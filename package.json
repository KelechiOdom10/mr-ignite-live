    "hono": "^4.11.9",
    "lucide-react": "^1.58.0",
    "motion": "^14.3.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.88.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@void/react": "1.7.0",
    "oxc-transform-react": "^0.149.0",
    "oxfmt": "^0.73.0",
    "oxlint": "1.88.0",
