{
  "extends": "./.void/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["void/env", "vite/client"],
    "jsx": "react-jsx",
    "paths": {
      "void/routes": ["./.void/routes.d.ts"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "pages", "routes", "middleware", "crons", "queues", "db"]
}
